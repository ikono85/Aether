<UserControl x:Class="Aether.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aether">
    <UserControl.Resources>
        <local:HealthToBrushConverter x:Key="HealthToBrush" />
        <local:BoolToVisConverter x:Key="BoolToVis" />
        <local:InverseBoolConverter x:Key="InvBool" />
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="320" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Margin="12,6,0,0">
                <TextBlock Text="SCANNER DE MENACES" Style="{StaticResource LabelText}" />
                <TextBlock Text="Analyse système en profondeur" Style="{StaticResource HeaderText}" Margin="0,4,0,0" />
            </StackPanel>

            <Grid Grid.Row="1">
                <!-- Scanner circulaire -->
                <Viewbox Width="380" Height="380">
                    <Grid Width="360" Height="360">
                        <Ellipse Width="360" Height="360" Stroke="#16FFFFFF" StrokeThickness="1" />
                        <Ellipse Width="290" Height="290" Stroke="#12FFFFFF" StrokeThickness="1" StrokeDashArray="2 5" />
                        <Ellipse Width="210" Height="210" Stroke="#12FFFFFF" StrokeThickness="1" />

                        <!-- Balayage rotatif (visible pendant le scan) -->
                        <Grid Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                            <Path Fill="{DynamicResource AccentBrush}" Opacity="0.18" RenderTransformOrigin="0.5,0.5"
                                  Data="M180,180 L180,10 A170,170 0 0,1 300,60 Z">
                                <Path.RenderTransform><RotateTransform x:Name="Sweep" /></Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="Sweep"
                                                    Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </Grid>

                        <!-- Centre : % ou état -->
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                                       FontSize="58" FontWeight="Light" Foreground="{StaticResource TextPrimaryBrush}"
                                       Text="{Binding Progress, StringFormat={}{0:0}%}" />
                            <TextBlock Text="{Binding Stage}" Style="{StaticResource LabelText}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>
                    </Grid>
                </Viewbox>
            </Grid>
        </Grid>

        <!-- Panneau latéral : progression + résultat + bouton -->
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,6,0,0">
            <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,12">
                <StackPanel Margin="22,20">
                    <TextBlock Text="PROGRESSION" Style="{StaticResource LabelText}" />
                    <ProgressBar Style="{StaticResource HoloBar}" Value="{Binding Progress}" Maximum="100" Margin="0,8,0,10" />
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding ProcessesChecked, StringFormat=Processus vérifiés : {0}}" />
                    <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding ProcessesTotal, StringFormat=Total : {0}}" Margin="0,2,0,0" />
                </StackPanel>
            </Border>

            <!-- Carte de menace -->
            <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,12">
                <StackPanel Margin="22,20">
                    <TextBlock Text="ÉTAT DE SÉCURITÉ" Style="{StaticResource LabelText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="14" Height="14" VerticalAlignment="Center"
                                 Fill="{Binding ThreatLevel, Converter={StaticResource HealthToBrush}}">
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="0" Opacity="0.9"
                                    Color="#2BE8A4" />
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="{Binding ThreatLabel}" Margin="12,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}" FontSize="15"
                                   Foreground="{Binding ThreatLevel, Converter={StaticResource HealthToBrush}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Margin="0,14,0,0"
                               FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}"
                    IsEnabled="{Binding IsScanning, Converter={StaticResource InvBool}}"
                    HorizontalAlignment="Stretch" Content="▶  LANCER L'ANALYSE" />
        </StackPanel>

        <!-- Liste des éléments réellement détectés -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource GlassPanel}" Margin="12,12,0,4"
                Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}" MaxHeight="240">
            <Grid Margin="22,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ÉLÉMENTS SIGNALÉS" Style="{StaticResource LabelText}" VerticalAlignment="Center" />
                    <Border CornerRadius="9" Padding="8,2" Margin="12,0,0,0" Background="#18FFFFFF">
                        <TextBlock Text="{Binding Items.Count}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                    </Border>
                </StackPanel>

                <!-- Message quand rien n'est signalé -->
                <TextBlock Grid.Row="1" Margin="0,16,0,0" VerticalAlignment="Center"
                           Text="✓  Aucun élément suspect. Tous les processus signés et emplacements sont sains."
                           FontSize="13" Foreground="{StaticResource AccentOptimalBrush}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="12" Background="#0DFFFFFF" BorderThickness="1"
                                        BorderBrush="#14FFFFFF" Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                 Margin="0,0,14,0"
                                                 Fill="{Binding Risk, Converter={StaticResource HealthToBrush}}" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontFamily="{StaticResource UiFont}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Category}" Style="{StaticResource LabelText}"
                                                           Margin="10,2,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Path}" FontFamily="{StaticResource MonoFont}"
                                                       FontSize="11" Foreground="{StaticResource TextMutedBrush}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="12"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Publisher, StringFormat=Éditeur : {0}}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                            <Border CornerRadius="8" Padding="8,3" Background="#14FFFFFF"
                                                    HorizontalAlignment="Right">
                                                <TextBlock FontFamily="{StaticResource MonoFont}" FontSize="10"
                                                           Foreground="{Binding Risk, Converter={StaticResource HealthToBrush}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="À SURVEILLER" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Risk}" Value="2">
                                                                    <Setter Property="Text" Value="SUSPECT" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                            <!-- Lien recherche web -->
                                            <Button Margin="0,8,0,0" HorizontalAlignment="Right" Cursor="Hand"
                                                    Command="{Binding DataContext.SearchWebCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Rechercher cet élément sur le web">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="lb" CornerRadius="8" Padding="9,4"
                                                                BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}"
                                                                Background="#10FFFFFF">
                                                            <TextBlock Text="🔍 Rechercher" FontSize="11"
                                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="lb" Property="Background" Value="#22FFFFFF" />
                                                                <Setter TargetName="lb" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
