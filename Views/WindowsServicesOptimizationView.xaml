<UserControl x:Class="Aether.Views.WindowsServicesOptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aether.ViewModels"
             xmlns:local="clr-namespace:Aether">

    <UserControl.Resources>
        <local:BoolToVisConverter x:Key="BoolToVis" />
        <local:ImpactToBrushConverter x:Key="ImpactToBrush" />
        <local:ImpactToLabelConverter x:Key="ImpactToLabel" />
        <local:InverseBoolConverter x:Key="InverseBool" />

        <!-- Interrupteur d'activation d'un service -->
        <Style x:Key="ServiceSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="track" Width="46" Height="24" CornerRadius="12"
                                Background="#18FFFFFF" BorderThickness="1"
                                BorderBrush="{StaticResource GlassStrokeBrush}">
                            <Border x:Name="knob" Width="18" Height="18" CornerRadius="9" Margin="2,0"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource TextMutedBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="#332BE8A4" />
                                <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentOptimalBrush}" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Background" Value="{StaticResource AccentOptimalBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Bouton discret (restaurer une ligne) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Padding="8,4" Background="Transparent"
                                BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#18FFFFFF" />
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Une ligne = un service -->
        <DataTemplate x:Key="ServiceRow">
            <Border CornerRadius="12" Margin="0,4" Padding="16,12" Background="#0AFFFFFF"
                    BorderThickness="1" BorderBrush="#12FFFFFF">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource UiFont}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />

                            <!-- Badge de risque -->
                            <Border Margin="10,0,0,0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                    Background="{Binding ImpactLevel, Converter={StaticResource ImpactToBrush}}"
                                    Opacity="0.9">
                                <TextBlock Text="{Binding ImpactLevel, Converter={StaticResource ImpactToLabel}}"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource CarbonBrush}" />
                            </Border>

                            <!-- Modifié par AETHER -->
                            <Border Margin="6,0,0,0" CornerRadius="4" Padding="6,2" VerticalAlignment="Center"
                                    Background="#229B6BFF"
                                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="MODIFIÉ" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource AccentAiBrush}" />
                            </Border>
                        </StackPanel>

                        <TextBlock Text="{Binding Condition}" TextWrapping="Wrap" Margin="0,6,20,0"
                                   FontSize="12" LineHeight="17" Foreground="{StaticResource TextMutedBrush}" />

                        <!-- État réel lu sur la machine -->
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource TextMutedBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentStatus}" Value="Running">
                                                <Setter Property="Fill" Value="{StaticResource AccentOptimalBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Margin="7,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}">
                                <Run Text="{Binding ResolvedName, Mode=OneWay}" />
                                <Run Text=" · " />
                                <Run Text="{Binding StatusText, Mode=OneWay}" />
                                <Run Text=" · démarrage " />
                                <Run Text="{Binding StartTypeText, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>

                        <TextBlock Text="{Binding Error}" TextWrapping="Wrap" Margin="0,8,20,0" FontSize="11"
                                   Foreground="{StaticResource AccentDangerBrush}"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Restaurer cette ligne -->
                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" VerticalAlignment="Center"
                            Margin="0,0,10,0" ToolTip="Restaurer le type de démarrage par défaut"
                            Command="{Binding DataContext.RestoreServiceCommand,
                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="↩" FontSize="14" Foreground="{StaticResource TextMutedBrush}" />
                    </Button>

                    <!-- Interrupteur : commande explicite, pas de binding IsChecked bidirectionnel -->
                    <ToggleButton Grid.Column="2" Style="{StaticResource ServiceSwitch}"
                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBool}}"
                                  Command="{Binding DataContext.ToggleServiceCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                  CommandParameter="{Binding}" />
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== En-tête ===== -->
        <StackPanel Margin="12,6,12,0">
            <TextBlock Text="SERVICES WINDOWS" Style="{StaticResource LabelText}" />
            <TextBlock Text="État réel des services système" Style="{StaticResource HeaderText}" Margin="0,4,0,0" />

            <!-- Élévation requise -->
            <Border Margin="0,14,0,0" CornerRadius="12" Padding="16,12" Background="#1AFFB347"
                    BorderThickness="1" BorderBrush="#40FFB347"
                    Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding ElevationMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                               FontSize="12" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button Grid.Column="1" Margin="16,0,0,0" Content="RELANCER EN ADMIN"
                            Command="{Binding ElevateCommand}" VerticalAlignment="Center"
                            Cursor="Hand" Padding="14,8" FontSize="11" FontWeight="SemiBold"
                            Background="#33FFB347" BorderBrush="#66FFB347" BorderThickness="1"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>
            </Border>

            <!-- Rappel honnête sur le gain réel -->
            <Border Margin="0,10,0,0" CornerRadius="12" Padding="16,12" Background="#0AFFFFFF"
                    BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" FontSize="14" VerticalAlignment="Top" Margin="0,1,10,0" />
                    <TextBlock Text="{Binding InfoBanner}" TextWrapping="Wrap" MaxWidth="820"
                               FontSize="12" LineHeight="18" Foreground="{StaticResource TextMutedBrush}" />
                </StackPanel>
            </Border>

            <!-- Profils prédéfinis -->
            <StackPanel Margin="0,14,0,0">
                <TextBlock Text="PROFILS PRÉDÉFINIS" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <ItemsControl ItemsSource="{Binding Profiles}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Margin="0,0,10,8" Cursor="Hand" Padding="0" BorderThickness="0"
                                    Background="Transparent"
                                    Command="{Binding DataContext.ApplyProfileCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <Border CornerRadius="10" Padding="14,10" Background="#12FFFFFF"
                                        BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}"
                                        MaxWidth="290">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                   FontSize="11" LineHeight="16"
                                                   Foreground="{StaticResource TextMutedBrush}" />
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>

        <!-- ===== Catégories pliables ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="12,14,12,0">
            <StackPanel>
                <TextBlock Text="Lecture de l'état des services…" Margin="4,20"
                           FontFamily="{StaticResource MonoFont}" FontSize="13"
                           Foreground="{StaticResource TextMutedBrush}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ServiceCategoryGroup}">
                            <Border Style="{StaticResource GlassPanel}" CornerRadius="16" Margin="0,0,0,12">
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" Padding="18,14">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Icon}" FontSize="16" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource UiFont}" FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <Border Margin="10,0,0,0" CornerRadius="9" Padding="7,2"
                                                    Background="#14FFFFFF" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Count}" FontSize="10"
                                                           FontFamily="{StaticResource MonoFont}"
                                                           Foreground="{StaticResource TextMutedBrush}" />
                                            </Border>
                                        </StackPanel>
                                    </Expander.Header>

                                    <ItemsControl ItemsSource="{Binding Services}" Margin="0,10,0,0"
                                                  ItemTemplate="{StaticResource ServiceRow}" />
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== Barre d'état ===== -->
        <Border Grid.Row="2" Style="{StaticResource GlassPanel}" CornerRadius="18" Margin="12,14,12,4">
            <Grid Margin="24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="0,0,20,0" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="⟳  ACTUALISER" Command="{Binding RefreshCommand}" Margin="0,0,12,0"
                            Cursor="Hand" Padding="16,10" FontSize="12" FontWeight="SemiBold"
                            Background="#12FFFFFF" BorderBrush="{StaticResource GlassStrokeBrush}"
                            BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" />

                    <Button Content="↩  TOUT RESTAURER" Command="{Binding RestoreAllCommand}"
                            IsEnabled="{Binding CanRestoreAll}"
                            Cursor="Hand" Padding="16,10" FontSize="12" FontWeight="SemiBold"
                            Background="#12FFFFFF" BorderBrush="{StaticResource GlassStrokeBrush}"
                            BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
