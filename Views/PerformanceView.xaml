<UserControl x:Class="Aether.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aether">
    <UserControl.Resources>
        <local:HealthToBrushConverter x:Key="HealthToBrush" />

        <!-- Liste de capteurs LibreHardwareMonitor -->
        <DataTemplate x:Key="SensorGroupHeader">
            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextMutedBrush}"
                       FontSize="11" FontWeight="SemiBold" Margin="0,8,0,4"
                       TextTrimming="CharacterEllipsis" />
        </DataTemplate>
        <!-- Message affiché quand la liste liée via Tag (HasItems) est vide -->
        <Style x:Key="EmptySensorHint" TargetType="TextBlock">
            <Setter Property="Text" Value="Aucun capteur détecté sur ce PC" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="8,8,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="SensorRow">
            <Grid Margin="8,2,4,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" Text="{Binding ValueText}" Margin="12,0,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}" />
            </Grid>
        </DataTemplate>

        <!-- Carte température "vivante" -->
        <DataTemplate x:Key="TempCard">
            <Border Style="{StaticResource GlassPanel}" CornerRadius="16" Margin="0,0,12,0" Width="220">
                <StackPanel Margin="20,18">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource MetricText}" />
                        <TextBlock Text="°C" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="3,0,0,6" />
                    </StackPanel>
                    <ProgressBar Style="{StaticResource HoloBar}" Value="{Binding TemperatureBar, Mode=OneWay}" Maximum="100"
                                 Margin="0,8,0,6"
                                 Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}" />
                    <TextBlock Text="{Binding HealthLabel}" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,6,0,0">
            <TextBlock Text="TÉLÉMÉTRIE LIVE" Style="{StaticResource LabelText}" />
            <TextBlock Text="Performance en continu" Style="{StaticResource HeaderText}" Margin="0,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="12,16,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <!-- Tous les capteurs de température (LibreHardwareMonitor) -->
        <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Margin="12,0,0,0">
            <Grid Margin="20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="CAPTEURS" Style="{StaticResource LabelText}" />
                <ScrollViewer Grid.Row="1" Margin="0,6,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="TEMPÉRATURES" Style="{StaticResource LabelText}" Margin="0,8,0,0" />
                        <ItemsControl x:Name="TemperatureList" ItemsSource="{Binding Temperatures}" ItemTemplate="{StaticResource SensorRow}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource SensorGroupHeader}" />
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource EmptySensorHint}" Tag="{Binding HasItems, ElementName=TemperatureList}" />

                        <TextBlock Text="VENTILATEURS" Style="{StaticResource LabelText}" Margin="0,18,0,0" />
                        <ItemsControl x:Name="FanList" ItemsSource="{Binding Fans}" ItemTemplate="{StaticResource SensorRow}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource SensorGroupHeader}" />
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource EmptySensorHint}" Tag="{Binding HasItems, ElementName=FanList}" />

                        <TextBlock Text="CONSOMMATION" Style="{StaticResource LabelText}" Margin="0,18,0,0" />
                        <ItemsControl x:Name="PowerList" ItemsSource="{Binding Powers}" ItemTemplate="{StaticResource SensorRow}">
                            <ItemsControl.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource SensorGroupHeader}" />
                            </ItemsControl.GroupStyle>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource EmptySensorHint}" Tag="{Binding HasItems, ElementName=PowerList}" />
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Graphe -->
        <Border Style="{StaticResource GlassPanel}">
            <Grid Margin="20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentOptimalBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="CPU" Style="{StaticResource LabelText}" Margin="8,0,20,0" VerticalAlignment="Center" />
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentAiBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="GPU" Style="{StaticResource LabelText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Viewbox Grid.Row="1" Stretch="Fill" Margin="0,14,0,0">
                    <Grid Width="620" Height="150">
                        <!-- lignes de grille -->
                        <Rectangle Height="1" Fill="#10FFFFFF" VerticalAlignment="Top" />
                        <Rectangle Height="1" Fill="#10FFFFFF" VerticalAlignment="Center" />
                        <Rectangle Height="1" Fill="#10FFFFFF" VerticalAlignment="Bottom" />
                        <Polyline Points="{Binding GpuPoints}" Stroke="{StaticResource AccentAiBrush}" StrokeThickness="2"
                                  StrokeLineJoin="Round" />
                        <Polyline Points="{Binding CpuPoints}" Stroke="{StaticResource AccentOptimalBrush}" StrokeThickness="2"
                                  StrokeLineJoin="Round" Effect="{DynamicResource GlowLineEffect}" />
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>
        </Grid>

        <!-- Cartes température -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="12,16,0,4">
            <ContentControl Content="{Binding Cpu}" ContentTemplate="{StaticResource TempCard}" />
            <ContentControl Content="{Binding Gpu}" ContentTemplate="{StaticResource TempCard}" />
            <ContentControl Content="{Binding Ram}" ContentTemplate="{StaticResource TempCard}" />
        </StackPanel>
    </Grid>
</UserControl>
