<Window x:Class="Aether.Views.ServiceConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aether"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">

    <Window.Resources>
        <local:BoolToVisConverter x:Key="BoolToVis" />
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource GraphiteBrush}"
            BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="Black" />
        </Border.Effect>

        <Grid Margin="28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Icône + titre -->
            <StackPanel Orientation="Horizontal">
                <Border Width="42" Height="42" CornerRadius="21" Background="{Binding LevelBrush}" Opacity="0.18" />
                <TextBlock Text="{Binding LevelIcon}" FontSize="20" Margin="-42,0,0,0" Width="42"
                           HorizontalAlignment="Center" TextAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DialogTitle}" Margin="14,0,0,0" VerticalAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="440"
                           FontFamily="{StaticResource UiFont}" FontSize="18" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>

            <!-- Badge de niveau -->
            <Border Grid.Row="1" HorizontalAlignment="Left" Margin="0,16,0,0" CornerRadius="5" Padding="8,3"
                    Background="{Binding LevelBrush}" Opacity="0.9">
                <TextBlock Text="{Binding LevelLabel}" FontSize="10" FontWeight="Bold"
                           Foreground="{StaticResource CarbonBrush}" />
            </Border>

            <!-- Conséquence concrète -->
            <TextBlock Grid.Row="2" Text="{Binding Body}" TextWrapping="Wrap" Margin="0,16,0,0"
                       FontSize="13" LineHeight="20" Foreground="{StaticResource TextPrimaryBrush}"
                       Opacity="0.9" />

            <!-- Détails additionnels (condition d'usage, ou liste d'un profil) -->
            <Border Grid.Row="3" Margin="0,16,0,0" CornerRadius="10" Padding="14,12"
                    Background="#10FFFFFF" BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}"
                    Visibility="{Binding HasDetails, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding DetailsHeader}" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding Details}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2" FontSize="12"
                                           LineHeight="17" Foreground="{StaticResource TextMutedBrush}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Case « ne plus demander » + actions -->
            <Grid Grid.Row="4" Margin="0,22,0,0">
                <CheckBox Content="Ne plus me demander pour les services sans risque"
                          IsChecked="{Binding DontAskAgain, Mode=TwoWay}"
                          VerticalAlignment="Center" Foreground="{StaticResource TextMutedBrush}"
                          FontSize="12" Cursor="Hand"
                          Visibility="{Binding ShowSkipOption, Converter={StaticResource BoolToVis}}" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" Click="OnCancel" IsCancel="True"
                            Cursor="Hand" Padding="18,10" FontSize="12" FontWeight="SemiBold"
                            Background="#12FFFFFF" BorderBrush="{StaticResource GlassStrokeBrush}"
                            BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" />

                    <Button Content="{Binding ConfirmLabel}" Click="OnConfirm" IsDefault="True" Margin="12,0,0,0"
                            Cursor="Hand" Padding="18,10" FontSize="12" FontWeight="SemiBold"
                            Background="{Binding ConfirmBrush}" BorderThickness="0"
                            Foreground="{StaticResource CarbonBrush}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
