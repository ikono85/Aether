<UserControl x:Class="Aether.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,10" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,6,0,0">
            <TextBlock Text="CONFIGURATION" Style="{StaticResource LabelText}" />
            <TextBlock Text="Paramètres du cockpit" Style="{StaticResource HeaderText}" Margin="0,4,0,0" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource GlassPanel}" Margin="12,16,0,4"
                VerticalAlignment="Top" HorizontalAlignment="Left" Width="480">
            <StackPanel Margin="28,24">
                <TextBlock Text="GÉNÉRAL" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <CheckBox Content="Lancer AETHER au démarrage de Windows" IsChecked="{Binding LaunchAtStartup}" />
                <CheckBox Content="Télémétrie temps réel" IsChecked="{Binding LiveTelemetry}" />

                <Border Height="1" Background="#18FFFFFF" Margin="0,16" />
                <TextBlock Text="APPARENCE" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                <CheckBox Content="Effets de particules et halos" IsChecked="{Binding ParticleEffects}" />
                <CheckBox Content="Analyses IA (accent violet dynamique)" IsChecked="{Binding AiInsights}" />

                <Border Height="1" Background="#18FFFFFF" Margin="0,16" />
                <TextBlock Text="INTERVALLE DE RAFRAÎCHISSEMENT" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                <Slider Minimum="1" Maximum="5" Value="{Binding RefreshRate}" TickFrequency="1"
                        IsSnapToTickEnabled="True" Foreground="{DynamicResource AccentBrush}" Width="260"
                        HorizontalAlignment="Left" />
                <TextBlock Text="{Binding RefreshRate, StringFormat=Toutes les {0} s}"
                           Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}"
                           FontSize="12" Margin="0,6,0,0" />

                <Border Height="1" Background="#18FFFFFF" Margin="0,20" />
                <TextBlock Text="{Binding Version}" Foreground="{StaticResource TextMutedBrush}"
                           FontFamily="{StaticResource MonoFont}" FontSize="11" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
