<UserControl x:Class="Aether.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,9" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <!-- Ligne d'explication sous un réglage : dit ce que la case change réellement. -->
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="24,-6,0,4" />
        </Style>

        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#18FFFFFF" />
            <Setter Property="Margin" Value="0,16" />
        </Style>

        <Style x:Key="Knob" TargetType="Slider">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="IsSnapToTickEnabled" Value="True" />
            <Setter Property="Width" Value="280" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,6,0,0">
            <TextBlock Text="CONFIGURATION" Style="{StaticResource LabelText}" />
            <TextBlock Text="Paramètres du cockpit" Style="{StaticResource HeaderText}" Margin="0,4,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <Grid Margin="12,0,12,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ============================ Colonne gauche ============================ -->
                <Border Style="{StaticResource GlassPanel}" Width="470" VerticalAlignment="Top">
                    <StackPanel Margin="28,24">

                        <TextBlock Text="DÉMARRAGE" Style="{StaticResource LabelText}" Margin="0,0,0,8" />

                        <CheckBox Content="Lancer AETHER à l'ouverture de session"
                                  IsChecked="{Binding LaunchAtStartup}"
                                  IsEnabled="{Binding IsElevated}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Crée une tâche planifiée « AetherAutoStart » exécutée avec les droits les plus élevés : pas d'invite UAC au démarrage. Nécessite une session administrateur." />

                        <CheckBox Content="Démarrer en fenêtre réduite" IsChecked="{Binding StartMinimized}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Utile avec le lancement automatique : la surveillance tourne sans occuper l'écran." />

                        <TextBlock Text="{Binding StartupStatus}" Style="{StaticResource Value}"
                                   TextWrapping="Wrap" Width="390" HorizontalAlignment="Left" />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="CAPTEURS" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <Slider Style="{StaticResource Knob}" Minimum="250" Maximum="5000"
                                TickFrequency="250" Value="{Binding SampleIntervalMs}" />
                        <TextBlock Text="{Binding IntervalLabel}" Style="{StaticResource Value}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,4"
                                   Text="Période d'interrogation de LibreHardwareMonitor. Plus court = courbes plus fines, mais lecture des capteurs plus fréquente donc un peu plus de CPU." />

                        <CheckBox Content="Suspendre les sondes quand la fenêtre est réduite"
                                  IsChecked="{Binding PauseWhenMinimized}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Rien n'est affiché quand la fenêtre est réduite : le timer s'arrête et reprend à la restauration." />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="SEUILS" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <Slider Style="{StaticResource Knob}" Minimum="45" Maximum="85"
                                TickFrequency="5" Value="{Binding ThermalComfortC}" />
                        <TextBlock Text="{Binding ThermalComfortC, StringFormat=Température de confort : {0} °C}"
                                   Style="{StaticResource Value}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,4"
                                   Text="Au-delà de ce seuil, le score de santé se dégrade et l'état bascule en CHARGE ÉLEVÉE puis PROBLÈME DÉTECTÉ. Montez-le sur un portable, descendez-le sur un watercooling." />

                        <CheckBox Content="Confirmer les optimisations à risque"
                                  IsChecked="{Binding ConfirmRiskyActions}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Demande une validation avant toute action système sans point de restauration enregistré." />
                    </StackPanel>
                </Border>

                <!-- ============================ Colonne droite ============================ -->
                <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Width="470"
                        Margin="16,0,0,0" VerticalAlignment="Top">
                    <StackPanel Margin="28,24">

                        <TextBlock Text="APPARENCE" Style="{StaticResource LabelText}" Margin="0,0,0,8" />

                        <CheckBox Content="Effets visuels (halos et ombres portées)"
                                  IsChecked="{Binding VisualEffects}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Désactive le flou des panneaux de verre sur toute l'interface. À couper sur un GPU intégré : c'est le poste de rendu le plus coûteux." />

                        <CheckBox Content="Accent coloré suivant l'état système"
                                  IsChecked="{Binding DynamicAccent}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Vert, orange ou rouge selon le score de santé. Décoché, l'interface reste verte en permanence." />

                        <TextBlock Text="ÉCHELLE DE L'INTERFACE" Style="{StaticResource LabelText}" Margin="0,10,0,10" />
                        <Slider Style="{StaticResource Knob}" Minimum="80" Maximum="150"
                                TickFrequency="5" Value="{Binding UiScale}" />
                        <TextBlock Text="{Binding ScaleLabel}" Style="{StaticResource Value}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,4"
                                   Text="Agrandit le contenu sans changer la taille de la fenêtre. Appliqué immédiatement." />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="ZONE DE NOTIFICATION ET ALERTES" Style="{StaticResource LabelText}" Margin="0,0,0,8" />

                        <CheckBox Content="Fermer dans la zone de notification" IsChecked="{Binding CloseToTray}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Le bouton fermer masque la fenêtre : la surveillance continue. « Quitter » dans le menu de l'icône arrête vraiment AETHER." />

                        <CheckBox Content="Alertes activées" IsChecked="{Binding AlertsEnabled}" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Interrupteur général, aussi disponible par clic droit sur l'icône." />

                        <CheckBox Content="Température CPU / GPU" IsChecked="{Binding AlertTemperature}"
                                  IsEnabled="{Binding AlertsEnabled}" Margin="24,6,0,4" />
                        <Slider Style="{StaticResource Knob}" Minimum="60" Maximum="100" TickFrequency="5"
                                Value="{Binding AlertTempC}" Margin="24,0,0,0" Width="256"
                                IsEnabled="{Binding AlertTemperature}" />
                        <TextBlock Text="{Binding AlertTempC, StringFormat=Alerte au-delà de {0} °C}"
                                   Style="{StaticResource Value}" Margin="24,6,0,0" />
                        <TextBlock Style="{StaticResource Hint}" Margin="24,4,0,4"
                                   Text="Distinct de la température de confort, qui ne règle que le score de santé. Réarmée après un retour 5 °C sous le seuil. Garde les sondes actives même fenêtre réduite." />

                        <CheckBox Content="Coupure et rétablissement de la connexion" IsChecked="{Binding AlertConnection}"
                                  IsEnabled="{Binding AlertsEnabled}" Margin="24,6,0,4" />
                        <CheckBox Content="Diagnostic réseau au rouge" IsChecked="{Binding AlertNetwork}"
                                  IsEnabled="{Binding AlertsEnabled}" Margin="24,6,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Margin="48,-2,0,4"
                                   Text="Uniquement si le problème dure au moins 15 secondes, une fois par épisode." />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="DIAGNOSTIC" Style="{StaticResource LabelText}" Margin="0,0,0,10" />
                        <TextBlock Text="{Binding ElevationStatus}" TextWrapping="Wrap" Width="390"
                                   HorizontalAlignment="Left" FontFamily="{StaticResource UiFont}"
                                   FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding SensorStatus}" TextWrapping="Wrap" Width="390"
                                   HorizontalAlignment="Left" Margin="0,8,0,0"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11.5"
                                   Foreground="{StaticResource TextMutedBrush}" />
                        <Button Content="Relire l'état des capteurs" Style="{StaticResource PrimaryButton}"
                                Command="{Binding RefreshDiagnosticsCommand}"
                                HorizontalAlignment="Left" Margin="0,12,0,0" />

                        <Border Style="{StaticResource Divider}" />

                        <TextBlock Text="DONNÉES" Style="{StaticResource LabelText}" Margin="0,0,0,8" />
                        <TextBlock Text="{Binding DataPath}" TextWrapping="Wrap" Width="390"
                                   HorizontalAlignment="Left" FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,4"
                                   Text="Ce dossier contient aussi restore.json (annulation des optimisations) et service-changes.json (journal des services Windows modifiés)." />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Ouvrir le dossier" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding OpenDataFolderCommand}" />
                            <Button Content="Réinitialiser les réglages" Style="{StaticResource PrimaryButton}"
                                    Command="{Binding ResetSettingsCommand}" Margin="10,0,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="{Binding Version}" Foreground="{StaticResource TextMutedBrush}"
                                   FontFamily="{StaticResource MonoFont}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
