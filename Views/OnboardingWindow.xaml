<Window x:Class="Aether.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="Bienvenue dans AETHER">

    <Window.Resources>
        <Style x:Key="Point" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource GraphiteBrush}"
            BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}">
        <StackPanel Margin="32,28">
            <TextBlock Text="BIENVENUE" Style="{StaticResource LabelText}" />
            <TextBlock Text="Ce que fait AETHER sur ce PC" Style="{StaticResource HeaderText}" Margin="0,4,0,14" />

            <TextBlock Style="{StaticResource Point}"
                       Text="🛡  Il s'exécute en administrateur : c'est nécessaire pour lire les températures (pilote PawnIO) et pour modifier services, registre et DNS quand vous le demandez." />
            <TextBlock Style="{StaticResource Point}"
                       Text="📡  Il surveille la connexion en continu : trois pings toutes les 5 secondes vers votre box, votre DNS, 1.1.1.1 (Cloudflare) et 8.8.8.8 (Google)." />
            <TextBlock Style="{StaticResource Point}"
                       Text="🔒  Il n'envoie aucune donnée vous concernant. Le test de débit (Cloudflare) ne démarre que sur votre demande ; la vérification des mises à jour n'interroge GitHub que si vous l'activez ci-dessous." />
            <TextBlock Style="{StaticResource Point}"
                       Text="↩  Chaque modification de Windows est sauvegardée et annulable depuis l'onglet Historique (Ctrl+7), même après un redémarrage." />
            <TextBlock Style="{StaticResource Point}"
                       Text="🗂  Les journaux restent sur ce PC (%LocalAppData%\Aether\logs) ; un rapport de diagnostic n'est créé que si vous le demandez." />

            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,16" />

            <TextBlock Text="VOS CHOIX (modifiables ensuite dans Paramètres)" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
            <CheckBox Content="Fermer la fenêtre dans la zone de notification (la surveillance continue)"
                      IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
            <CheckBox Content="Notifications en cas de surchauffe ou de coupure de connexion"
                      IsChecked="{Binding AlertsEnabled, Mode=TwoWay}" />
            <CheckBox Content="Créer un point de restauration Windows avant de modifier le système"
                      IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}" />
            <CheckBox Content="Vérifier les nouvelles versions sur GitHub (une fois par jour)"
                      IsChecked="{Binding CheckForUpdates, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                <Button Content="Plus tard" Click="OnLater" IsCancel="True"
                        Cursor="Hand" Padding="18,10" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                        Background="{StaticResource GlassTintBrush}" BorderBrush="{StaticResource GlassStrokeBrush}"
                        BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" />
                <Button Content="Commencer" Click="OnStart" IsDefault="True" Margin="12,0,0,0"
                        Cursor="Hand" Padding="22,10" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                        Background="{StaticResource AccentOptimalBrush}" BorderThickness="0"
                        Foreground="{StaticResource CarbonBrush}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
