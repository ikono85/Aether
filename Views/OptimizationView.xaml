<UserControl x:Class="Aether.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Aether.ViewModels"
             xmlns:local="clr-namespace:Aether">
    <UserControl.Resources>
        <local:BoolToVisConverter x:Key="BoolToVis" />

        <!-- Bouton flèche déroulante -->
        <Style x:Key="ExpandArrow" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ab" CornerRadius="13" Background="#12FFFFFF">
                            <TextBlock x:Name="chev" Text="⌄" FontSize="15" Foreground="{StaticResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderTransformOrigin="0.5,0.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ab" Property="Background" Value="#22FFFFFF" />
                                <Setter TargetName="chev" Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                <Setter TargetName="chev" Property="RenderTransform">
                                    <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                                </Setter>
                                <Setter TargetName="chev" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Module activable (ToggleButton holographique) -->
        <Style x:Key="ModuleToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Width="250" MinHeight="120" Margin="10" CornerRadius="16"
                                BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}"
                                Background="#10FFFFFF">
                            <Grid Margin="18,14">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontSize="20" />
                                        <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource UiFont}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                    <!-- Flèche : déroule les détails (n'active pas le module) -->
                                    <Button Style="{StaticResource ExpandArrow}" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Command="{Binding ToggleExpandCommand}"
                                            ToolTip="Voir ce que fait cette optimisation" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="Wrap"
                                           Margin="0,10,0,0" FontSize="12"
                                           Foreground="{StaticResource TextMutedBrush}" />
                                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="dot" Width="8" Height="8" CornerRadius="4"
                                                Background="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="st" Text="INACTIF · cliquer pour activer" Margin="8,0,0,0"
                                                   Style="{StaticResource LabelText}" />
                                        <!-- Badge « administrateur requis » -->
                                        <Border Margin="8,0,0,0" CornerRadius="4" Padding="5,1" Background="#22FFB347"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding RequiresAdmin, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="ADMIN" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentWarnBrush}" />
                                        </Border>
                                        <!-- Appliqué : annulable, même après redémarrage d'AETHER -->
                                        <Border Margin="6,0,0,0" CornerRadius="4" Padding="5,1" Background="#2200E58F"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="APPLIQUÉ" FontSize="9" FontWeight="SemiBold"
                                                       Foreground="{StaticResource AccentOptimalBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Compte rendu réel de la dernière exécution -->
                                    <TextBlock Text="{Binding LastResult}" TextWrapping="Wrap" Margin="0,10,0,0"
                                               FontSize="11" LineHeight="15"
                                               Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LastOutcome}" Value="Applied">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentOptimalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LastOutcome}" Value="Reverted">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentOptimalBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LastOutcome}" Value="Failed">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentDangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Text="⏳ en cours…" Margin="0,8,0,0" FontSize="11"
                                               Foreground="{DynamicResource AccentBrush}"
                                               Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <!-- Panneau déroulant -->
                                <Border Grid.Row="3" Margin="0,12,0,0"
                                        Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Border Height="1" Background="#18FFFFFF" Margin="0,0,0,10" />
                                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="12"
                                                   LineHeight="17" Foreground="{StaticResource TextPrimaryBrush}"
                                                   Opacity="0.85" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bd" Property="Background" Value="#1A9B6BFF" />
                                <Setter TargetName="dot" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="st" Property="Text" Value="ACTIF" />
                                <Setter TargetName="st" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="12,6,0,0">
            <TextBlock Text="PERFORMANCE CORE" Style="{StaticResource LabelText}" />
            <TextBlock Text="Arbre d'optimisation" Style="{StaticResource HeaderText}" Margin="0,4,0,0" />

            <!-- Élévation requise par un ou plusieurs modules sélectionnés -->
            <Border Margin="0,14,12,0" CornerRadius="12" Padding="16,12" Background="#1AFFB347"
                    BorderThickness="1" BorderBrush="#40FFB347"
                    Visibility="{Binding NeedsElevation, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="Certains modules sélectionnés modifient le système et demandent les droits administrateur. Sans élévation, ils seront ignorés — les autres s'appliqueront normalement." />
                    <Button Grid.Column="1" Margin="16,0,0,0" Content="RELANCER EN ADMIN"
                            Command="{Binding ElevateCommand}" VerticalAlignment="Center"
                            Cursor="Hand" Padding="14,8" FontSize="11" FontWeight="SemiBold"
                            Background="#33FFB347" BorderBrush="#66FFB347" BorderThickness="1"
                            Foreground="{StaticResource TextPrimaryBrush}" />
                </Grid>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
            <ItemsControl ItemsSource="{Binding Modules}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:OptimizationModule}">
                        <ToggleButton Style="{StaticResource ModuleToggle}"
                                      IsChecked="{Binding Enabled, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Barre d'action -->
        <Border Grid.Row="2" Style="{StaticResource GlassPanel}" CornerRadius="18" Margin="12,16,0,4">
            <Grid Margin="24,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource TextPrimaryBrush}"
                               FontFamily="{StaticResource MonoFont}" FontSize="13" />
                    <ProgressBar Style="{StaticResource HoloBar}" Value="{Binding Progress}" Maximum="100"
                                 Margin="0,10,20,0" Width="420" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Annule les modules déjà appliqués, en restaurant l'état sauvegardé -->
                    <Button Content="↩  RESTAURER" Command="{Binding RevertCommand}" Margin="0,0,12,0"
                            Cursor="Hand" Padding="16,10" FontSize="12" FontWeight="SemiBold"
                            Background="#12FFFFFF" BorderBrush="{StaticResource GlassStrokeBrush}"
                            BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" />

                    <Button Content="✕  ANNULER" Command="{Binding CancelCommand}" Margin="0,0,12,0"
                            Cursor="Hand" Padding="16,10" FontSize="12" FontWeight="SemiBold"
                            Background="#12FFFFFF" BorderBrush="{StaticResource GlassStrokeBrush}"
                            BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />

                    <Button Style="{StaticResource PrimaryButton}" Content="⚡  OPTIMISER"
                            Command="{Binding OptimizeCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
