<Window x:Class="Aether.Views.StartupChoiceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="Height" Width="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="AETHER — programmes au démarrage">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Border CornerRadius="18" Background="{StaticResource GraphiteBrush}"
            BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}">
        <StackPanel Margin="28,24">
            <TextBlock Text="STARTUP MANAGER" Style="{StaticResource LabelText}" />
            <TextBlock Text="Quels programmes ne doivent plus démarrer avec Windows ?" Margin="0,4,0,0"
                       TextWrapping="Wrap" FontFamily="{StaticResource UiFont}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="{StaticResource FontSizeSmall}"
                       Foreground="{StaticResource TextMutedBrush}"
                       Text="Décochez ce qui doit continuer à se lancer (synchronisation cloud, utilitaire audio ou de souris, antivirus tiers…). Chaque programme désactivé reste réactivable depuis l'onglet Historique." />

            <Border Margin="0,16,0,0" CornerRadius="10" Padding="14,10" MaxHeight="320"
                    Background="{StaticResource GlassTintBrush}" BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Choices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Grid Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal">
                    <Button Content="Tout cocher" Click="OnSelectAll" Style="{StaticResource TitleBtn}" Padding="8,4" Height="30" Width="100" />
                    <Button Content="Tout décocher" Click="OnSelectNone" Style="{StaticResource TitleBtn}" Padding="8,4" Height="30" Width="110" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" Click="OnCancel" IsCancel="True"
                            Cursor="Hand" Padding="18,10" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                            Background="{StaticResource GlassTintBrush}" BorderBrush="{StaticResource GlassStrokeBrush}"
                            BorderThickness="1" Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button Content="Désactiver la sélection" Click="OnConfirm" IsDefault="True" Margin="12,0,0,0"
                            Cursor="Hand" Padding="18,10" FontSize="{StaticResource FontSizeSmall}" FontWeight="SemiBold"
                            Background="{StaticResource AccentWarnBrush}" BorderThickness="0"
                            Foreground="{StaticResource CarbonBrush}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
