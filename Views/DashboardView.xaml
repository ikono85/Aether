<UserControl x:Class="Aether.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Aether"
             xmlns:m="clr-namespace:Aether.Models">
    <UserControl.Resources>
        <local:HealthToBrushConverter x:Key="HealthToBrush" />

        <!-- Carte "module holographique" -->
        <DataTemplate x:Key="ModuleCard" DataType="{x:Type m:HardwareModule}">
            <Border Style="{StaticResource GlassPanel}" CornerRadius="16" Width="200" Margin="10">
                <StackPanel Margin="18,16">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" VerticalAlignment="Center"
                                 Fill="{Binding Health, Converter={StaticResource HealthToBrush}}" />
                        <TextBlock Text="{Binding Name}" Style="{StaticResource LabelText}"
                                   Margin="10,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource LabelText}"
                                   Opacity="0.6" HorizontalAlignment="Right" Margin="10,0,0,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="{Binding TemperatureText}"
                                   Style="{StaticResource MetricText}" />
                        <TextBlock Text="°C" Foreground="{StaticResource TextMutedBrush}"
                                   VerticalAlignment="Bottom" Margin="3,0,0,6" />
                        <TextBlock Text="{Binding HealthLabel}" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                   Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}" />
                    </StackPanel>

                    <TextBlock Text="UTILISATION" Style="{StaticResource LabelText}" Margin="0,12,0,4" />
                    <ProgressBar Style="{StaticResource HoloBar}" Value="{Binding UsageBar, Mode=OneWay}" Maximum="100"
                                 Foreground="{Binding Health, Converter={StaticResource HealthToBrush}}" />
                    <TextBlock Margin="0,4,0,0" FontFamily="{StaticResource MonoFont}" FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="{Binding UsageText}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
        </Grid.ColumnDefinitions>

        <!-- Zone centrale : silhouette PC + modules autour -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="12,6,0,10">
                <TextBlock Text="DIAGNOSTIC HOLOGRAPHIQUE" Style="{StaticResource LabelText}" />
                <TextBlock Text="Votre PC, analysé en temps réel" Style="{StaticResource HeaderText}" Margin="0,4,0,0" />
            </StackPanel>

            <Viewbox Grid.Row="1" Stretch="Uniform" Margin="0,0,0,4">
                <Grid Width="720" Height="520">
                    <!-- Anneaux holographiques derrière la silhouette -->
                    <Ellipse Width="360" Height="360" Stroke="#14FFFFFF" StrokeThickness="1" />
                    <Ellipse Width="470" Height="470" Stroke="#0AFFFFFF" StrokeThickness="1" StrokeDashArray="2 6" />

                    <!-- Silhouette futuriste du PC (tour stylisée) -->
                    <Border Width="150" Height="240" CornerRadius="20" BorderThickness="1.5"
                            BorderBrush="#33FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#22FFFFFF" Offset="0" />
                                <GradientStop Color="#08FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="60" ShadowDepth="0" Opacity="0.6" Color="#2BE8A4" />
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="◉" FontSize="40" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="AETHER" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"
                                       Margin="0,8,0,0" />
                            <Rectangle Height="1" Fill="#22FFFFFF" Width="70" Margin="0,10" />
                            <TextBlock Text="LIVE CORE" Style="{StaticResource LabelText}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Modules flottants positionnés autour -->
                    <ContentPresenter Content="{Binding Cpu}" ContentTemplate="{StaticResource ModuleCard}"
                                      HorizontalAlignment="Left" VerticalAlignment="Top" />
                    <ContentPresenter Content="{Binding Gpu}" ContentTemplate="{StaticResource ModuleCard}"
                                      HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <ContentPresenter Content="{Binding Ram}" ContentTemplate="{StaticResource ModuleCard}"
                                      HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                    <ContentPresenter Content="{Binding Ssd}" ContentTemplate="{StaticResource ModuleCard}"
                                      HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    <ContentPresenter Content="{Binding Net}" ContentTemplate="{StaticResource ModuleCard}"
                                      HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Panneau SYSTEM STATUS -->
        <Border Grid.Column="1" Style="{StaticResource GlassPanel}" Margin="12,6,0,4">
            <StackPanel Margin="24,26">
                <TextBlock Text="SYSTEM STATUS" Style="{StaticResource LabelText}" />
                <StackPanel Orientation="Horizontal" Margin="0,14,0,2" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding DataContext.HealthScore, RelativeSource={RelativeSource AncestorType=Window}, StringFormat={}{0:0}}"
                               FontFamily="{StaticResource MonoFont}" FontSize="72" FontWeight="Light"
                               Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="%" Foreground="{StaticResource TextMutedBrush}" FontSize="24"
                               VerticalAlignment="Bottom" Margin="4,0,0,14" />
                </StackPanel>
                <TextBlock Text="{Binding DataContext.StateLabel, RelativeSource={RelativeSource AncestorType=Window}}"
                           HorizontalAlignment="Center" FontFamily="{StaticResource MonoFont}" FontSize="12"
                           Foreground="{DynamicResource AccentBrush}" Margin="0,0,0,22" />

                <TextBlock Text="TEMPERATURE" Style="{StaticResource LabelText}" Margin="0,0,0,5" />
                <ProgressBar Style="{StaticResource HoloBar}" Value="{Binding TemperatureScore}" Maximum="100" />

                <TextBlock Text="PERFORMANCE" Style="{StaticResource LabelText}" Margin="0,18,0,5" />
                <ProgressBar Style="{StaticResource HoloBar}" Value="{Binding PerformanceScore}" Maximum="100" />

                <TextBlock Text="SECURITY" Style="{StaticResource LabelText}" Margin="0,18,0,5" />
                <ProgressBar Style="{StaticResource HoloBar}" Value="{Binding SecurityScore}" Maximum="100" />

                <Border Height="1" Background="#18FFFFFF" Margin="0,26" />
                <TextBlock Text="L'organisme est stable. Tous les sous-systèmes répondent."
                           TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
