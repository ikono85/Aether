<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ PALETTE : CARBONE / GRAPHITE / HOLOGRAMME ============ -->
    <Color x:Key="CarbonColor">#FF07090D</Color>
    <Color x:Key="CarbonDeepColor">#FF04050A</Color>
    <Color x:Key="GraphiteColor">#FF12161F</Color>
    <Color x:Key="GraphiteLightColor">#FF1B2130</Color>
    <Color x:Key="GlassStrokeColor">#22FFFFFF</Color>
    <Color x:Key="TextPrimaryColor">#FFEAF2FF</Color>
    <Color x:Key="TextMutedColor">#FF8A9BB4</Color>

    <!-- Accents dynamiques selon l'état -->
    <Color x:Key="AccentOptimalColor">#FF2BE8A4</Color>   <!-- vert : parfait -->
    <Color x:Key="AccentWarnColor">#FFFFB020</Color>      <!-- orange : attention -->
    <Color x:Key="AccentDangerColor">#FFFF3B5C</Color>    <!-- rouge : problème -->
    <Color x:Key="AccentAiColor">#FF9B6BFF</Color>        <!-- violet : mesure en cours / modifié -->

    <SolidColorBrush x:Key="CarbonBrush" Color="{StaticResource CarbonColor}" />
    <SolidColorBrush x:Key="CarbonDeepBrush" Color="{StaticResource CarbonDeepColor}" />
    <SolidColorBrush x:Key="GraphiteBrush" Color="{StaticResource GraphiteColor}" />
    <SolidColorBrush x:Key="GraphiteLightBrush" Color="{StaticResource GraphiteLightColor}" />
    <SolidColorBrush x:Key="GlassStrokeBrush" Color="{StaticResource GlassStrokeColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="AccentOptimalBrush" Color="{StaticResource AccentOptimalColor}" />
    <SolidColorBrush x:Key="AccentWarnBrush" Color="{StaticResource AccentWarnColor}" />
    <SolidColorBrush x:Key="AccentDangerBrush" Color="{StaticResource AccentDangerColor}" />
    <SolidColorBrush x:Key="AccentAiBrush" Color="{StaticResource AccentAiColor}" />

    <!-- Teintes translucides : une seule valeur par usage, au lieu de codes hexadécimaux épars. -->
    <SolidColorBrush x:Key="GlassTintBrush" Color="#10FFFFFF" />
    <SolidColorBrush x:Key="GlassTintHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="AccentOptimalSoftBrush" Color="#222BE8A4" />
    <SolidColorBrush x:Key="AccentWarnSoftBrush" Color="#22FFB020" />
    <SolidColorBrush x:Key="AccentAiSoftBrush" Color="#229B6BFF" />

    <!-- Accent "actif" piloté dynamiquement par le ViewModel principal -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentOptimalColor}" />

    <!-- ============ JETONS : TYPOGRAPHIE, RAYONS ============ -->
    <!-- 11 px est le minimum : les textes en 9-10 px étaient illisibles sur écran standard. -->
    <sys:Double x:Key="FontSizeCaption">11</sys:Double>
    <sys:Double x:Key="FontSizeSmall">12</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeTitle">15</sys:Double>
    <sys:Double x:Key="FontSizeHeader">22</sys:Double>

    <CornerRadius x:Key="RadiusBadge">4</CornerRadius>
    <CornerRadius x:Key="RadiusControl">10</CornerRadius>
    <CornerRadius x:Key="RadiusCard">16</CornerRadius>

    <!-- ============ EFFETS ============
         Les ombres et lueurs (PanelShadow, GlowAccentEffect, GlowNodeEffect, GlowLineEffect,
         GlowBarEffect, GlowButtonEffect, CoreGlowEffect) ne sont PAS définies ici : elles sont
         ajoutées ou retirées au niveau de l'application par Themes/VisualEffects.cs.
         Définies dans ce dictionnaire, elles resteraient visibles même « désactivées » : WPF
         ignore une ressource d'application valant null et retombe sur celle du thème. -->


    <FontFamily x:Key="UiFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Code, Consolas</FontFamily>

    <!-- ============ FOCUS CLAVIER ============
         Le rectangle pointillé noir par défaut est invisible sur fond sombre : sans lui,
         la navigation au clavier (Tab) ne montre pas où l'on se trouve. -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="6" RadiusY="6" StrokeThickness="2"
                               Stroke="{DynamicResource AccentBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ VERRE : panneau glassmorphism ============ -->
    <Style x:Key="GlassPanel" TargetType="Border">
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{StaticResource GlassStrokeBrush}" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#14FFFFFF" Offset="0" />
                    <GradientStop Color="#06FFFFFF" Offset="0.5" />
                    <GradientStop Color="#10000000" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect" Value="{DynamicResource PanelShadow}" />
    </Style>

    <!-- Texte : titres holographiques -->
    <Style x:Key="HeaderText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeHeader}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="LabelText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
    </Style>

    <Style x:Key="MetricText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="FontWeight" Value="Light" />
    </Style>

    <!-- ============ Barre de progression holographique ============ -->
    <Style x:Key="HoloBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="Background" Value="#20FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border CornerRadius="3" Background="{TemplateBinding Background}" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3"
                                Background="{TemplateBinding Foreground}"
                                Effect="{DynamicResource GlowBarEffect}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Bouton "module" activable ============ -->
    <Style x:Key="ModuleButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="14" BorderThickness="1"
                            BorderBrush="{StaticResource GlassStrokeBrush}"
                            Background="{StaticResource GlassTintBrush}" Padding="18,14">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource GlassTintHoverBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Bouton de navigation (noyau système) ============ -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="bd" CornerRadius="12" Padding="16,11" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="tick" Grid.Column="0" Width="3" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" Opacity="0"
                                    HorizontalAlignment="Left" Margin="0,2" />
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#0DFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#14FFFFFF" />
                            <Setter TargetName="tick" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Boutons de la barre de titre -->
    <Style x:Key="TitleBtn" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="Transparent" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#1AFFFFFF" />
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Bouton d'action principal (verre lumineux, bordure à la couleur d'accent) -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" CornerRadius="24" Padding="26,14" BorderThickness="1"
                            BorderBrush="{DynamicResource AccentBrush}" Background="{StaticResource GlassTintBrush}"
                            Effect="{DynamicResource GlowButtonEffect}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#33FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
