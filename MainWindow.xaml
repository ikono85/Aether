<Window x:Class="Aether.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Aether.ViewModels"
        xmlns:v="clr-namespace:Aether.Views"
        xmlns:local="clr-namespace:Aether"
        Title="AETHER"
        Height="820" Width="1300" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="{StaticResource CarbonDeepBrush}">

    <!-- Fenêtre opaque (sans AllowsTransparency) : rendu matériel normal, ancrage Windows et
         coins arrondis natifs de Windows 11 (voir MainWindow.xaml.cs). -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <!-- Raccourcis : Ctrl+1 à Ctrl+6 pour chaque onglet. -->
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="D1" Command="{Binding NavigateCommand}" CommandParameter="Dashboard" />
        <KeyBinding Modifiers="Ctrl" Key="D2" Command="{Binding NavigateCommand}" CommandParameter="Network" />
        <KeyBinding Modifiers="Ctrl" Key="D3" Command="{Binding NavigateCommand}" CommandParameter="Optimization" />
        <KeyBinding Modifiers="Ctrl" Key="D4" Command="{Binding NavigateCommand}" CommandParameter="WindowsServices" />
        <KeyBinding Modifiers="Ctrl" Key="D5" Command="{Binding NavigateCommand}" CommandParameter="Performance" />
        <KeyBinding Modifiers="Ctrl" Key="D6" Command="{Binding NavigateCommand}" CommandParameter="Settings" />
        <KeyBinding Modifiers="Ctrl" Key="D7" Command="{Binding NavigateCommand}" CommandParameter="History" />
    </Window.InputBindings>

    <Window.Resources>
        <local:StateToBrushConverter x:Key="StateToBrush" />
        <local:StateToColorConverter x:Key="StateToColor" />
        <local:EqualsConverter x:Key="Equals" />
        <local:BoolToVisConverter x:Key="BoolToVis" />

        <!-- Association ViewModel -> Vue -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkViewModel}"><v:NetworkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OptimizationViewModel}"><v:OptimizationView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WindowsServicesOptimizationViewModel}"><v:WindowsServicesOptimizationView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:PerformanceViewModel}"><v:PerformanceView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><v:HistoryView /></DataTemplate>
    </Window.Resources>

    <!-- Cadre extérieur : carbone profond + halo. La marge compense le débordement d'une fenêtre
         sans bordure une fois maximisée (MainWindow.xaml.cs). -->
    <Border x:Name="Root" BorderThickness="1" BorderBrush="{StaticResource GlassStrokeBrush}">
        <!-- Échelle de l'interface, réglable dans Paramètres (la fenêtre, elle, ne bouge pas). -->
        <Border.LayoutTransform>
            <ScaleTransform ScaleX="{Binding Settings.Scale}" ScaleY="{Binding Settings.Scale}" />
        </Border.LayoutTransform>
        <Border.Background>
            <RadialGradientBrush GradientOrigin="0.15,0.1" Center="0.15,0.1" RadiusX="1.1" RadiusY="1.1">
                <GradientStop Color="#FF0B0E15" Offset="0" />
                <GradientStop Color="{StaticResource CarbonDeepColor}" Offset="0.9" />
            </RadialGradientBrush>
        </Border.Background>

        <Grid>
            <!-- Halo d'accent au centre, suit l'état -->
            <Ellipse Width="900" Height="900" Opacity="0.10" IsHitTestVisible="False"
                     HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="{Binding State, Converter={StaticResource StateToColor}}" Offset="0" />
                        <GradientStop Color="#00000000" Offset="0.7" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Settings.AnimationsEnabled}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="HaloPulse">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="0.06" To="0.14" Duration="0:0:4" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="HaloPulse" />
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== BARRE DE TITRE ===== -->
                <Grid Grid.Row="0" Grid.ColumnSpan="2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="26,0,0,0">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{Binding State, Converter={StaticResource StateToBrush}}" />
                        <TextBlock Text="AETHER" FontFamily="{StaticResource MonoFont}" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="CENTRE DE CONTRÔLE PC" Style="{StaticResource LabelText}"
                                   VerticalAlignment="Center" Margin="12,1,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,10,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="—" Click="Minimize" Width="40" Height="30" Style="{StaticResource TitleBtn}"
                                AutomationProperties.Name="Réduire" ToolTip="Réduire" />
                        <Button Content="□" Click="MaxRestore" Width="40" Height="30" Style="{StaticResource TitleBtn}"
                                AutomationProperties.Name="Agrandir ou restaurer" ToolTip="Agrandir / restaurer" />
                        <Button Content="✕" Click="CloseWin" Width="40" Height="30" Style="{StaticResource TitleBtn}"
                                AutomationProperties.Name="Fermer" ToolTip="Fermer" />
                    </StackPanel>
                </Grid>

                <!-- ===== NOYAU SYSTÈME + NAVIGATION ===== -->
                <Border Grid.Row="1" Grid.Column="0" Margin="16,0,8,16" Style="{StaticResource GlassPanel}">
                    <Grid Margin="12,22,12,18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Noyau animé (animations coupées avec les effets visuels ou si Windows les désactive) -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                            <Grid Width="120" Height="120" IsHitTestVisible="False">
                                <Ellipse Width="120" Height="120" Stroke="#22FFFFFF" StrokeThickness="1" />
                                <Ellipse Width="96" Height="96" StrokeThickness="2"
                                         Stroke="{Binding State, Converter={StaticResource StateToBrush}}"
                                         StrokeDashArray="6 4" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform><RotateTransform /></Ellipse.RenderTransform>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.AnimationsEnabled}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="CoreSpin">
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:14" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="CoreSpin" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <Ellipse Width="46" Height="46" Opacity="0.9"
                                         Fill="{Binding State, Converter={StaticResource StateToBrush}}"
                                         Effect="{DynamicResource CoreGlowEffect}">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Settings.AnimationsEnabled}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="CorePulse">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                 From="0.55" To="1" Duration="0:0:1.6" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="CorePulse" />
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="◉" FontSize="20" Foreground="{StaticResource CarbonBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="NOYAU SYSTÈME" Style="{StaticResource LabelText}"
                                       HorizontalAlignment="Center" Margin="0,14,0,2" />
                            <TextBlock Text="{Binding StateLabel}" FontFamily="{StaticResource MonoFont}"
                                       FontSize="{StaticResource FontSizeCaption}" HorizontalAlignment="Center"
                                       Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                        </StackPanel>

                        <!-- Navigation : liée à la page active dans les deux sens (clic ou Ctrl+1…6) -->
                        <StackPanel Grid.Row="1" Margin="4,28,4,0" KeyboardNavigation.DirectionalNavigation="Cycle">
                            <RadioButton Style="{StaticResource NavButton}" Content="◱   Tableau de bord"
                                         AutomationProperties.Name="Tableau de bord" ToolTip="Tableau de bord (Ctrl+1)"
                                         IsChecked="{Binding ActivePage, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Dashboard}" />
                            <RadioButton Style="{StaticResource NavButton}" Content="⟀   Réseau"
                                         AutomationProperties.Name="Réseau" ToolTip="Réseau (Ctrl+2)"
                                         IsChecked="{Binding ActivePage, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Network}" />
                            <RadioButton Style="{StaticResource NavButton}" Content="⚙   Optimisation"
                                         AutomationProperties.Name="Optimisation" ToolTip="Optimisation (Ctrl+3)"
                                         IsChecked="{Binding ActivePage, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Optimization}" />
                            <RadioButton Style="{StaticResource NavButton}" Content="⛭   Services"
                                         AutomationProperties.Name="Services Windows" ToolTip="Services Windows (Ctrl+4)"
                                         IsChecked="{Binding ActivePage, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=WindowsServices}" />
                            <RadioButton Style="{StaticResource NavButton}" Content="◭   Performance"
                                         AutomationProperties.Name="Performance" ToolTip="Performance (Ctrl+5)"
                                         IsChecked="{Binding ActivePage, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Performance}" />
                            <RadioButton Style="{StaticResource NavButton}" Content="↺   Historique"
                                         AutomationProperties.Name="Historique" ToolTip="Historique des modifications et de la connexion (Ctrl+7)"
                                         IsChecked="{Binding ActivePage, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=History}" />
                            <RadioButton Style="{StaticResource NavButton}" Content="⚑   Paramètres"
                                         AutomationProperties.Name="Paramètres" ToolTip="Paramètres (Ctrl+6)"
                                         IsChecked="{Binding ActivePage, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter=Settings}" />
                        </StackPanel>

                        <!-- Score compact en bas -->
                        <StackPanel Grid.Row="2" Margin="8,0,8,0"
                                    AutomationProperties.Name="{Binding HealthAccessibleText}">
                            <TextBlock Text="SCORE DE SANTÉ" Style="{StaticResource LabelText}" />
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,6">
                                <TextBlock Text="{Binding HealthText}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="34" FontWeight="Light"
                                           Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                                <TextBlock Text="%" Foreground="{StaticResource TextMutedBrush}"
                                           VerticalAlignment="Bottom" Margin="4,0,0,8" />
                            </StackPanel>
                            <ProgressBar Style="{StaticResource HoloBar}" Minimum="0" Maximum="100"
                                         Value="{Binding HealthScore, Mode=OneWay}"
                                         Foreground="{Binding State, Converter={StaticResource StateToBrush}}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ===== CONTENU ===== -->
                <ContentControl Grid.Row="1" Grid.Column="1" Margin="8,0,16,16" Focusable="False"
                                Content="{Binding Current}" />
            </Grid>
        </Grid>
    </Border>
</Window>
