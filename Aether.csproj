<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 (LTS) : .NET 8 n'est plus pris en charge après novembre 2026. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.2.0</Version>
    <Product>AETHER</Product>
    <Company>AETHER</Company>
    <Copyright>© 2026 AETHER</Copyright>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Uniquement pour NotifyIcon (zone de notification) : WPF n'en a pas d'équivalent. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- WFAC010 réclame le DPI via l'API WinForms : sans objet ici, la fenêtre est en WPF
         et son DPI par moniteur est correctement déclaré dans app.manifest. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <AssemblyName>Aether</AssemblyName>
    <RootNamespace>Aether</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- WinForms ajoute ces usings globaux : ils rendraient ambigus Application, MessageBox,
       Color, Point… partout dans le code WPF. Les types WinForms restent qualifiés. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <!-- Le projet de tests et l'installeur vivent sous ce dossier : ils ne font pas partie de l'application. -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
    <None Remove="installer\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aether.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.12" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.12" />
  </ItemGroup>

</Project>
